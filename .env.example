# Database Configuration
POSTGRES_USER=hr_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=hr_core_db
POSTGRES_PORT=5432

# Prisma Connection URL
DATABASE_URL="postgresql://hr_admin:your_secure_password@localhost:5432/hr_core_db?schema=public"

# n8n Automation Engine
N8N_PORT=5679
N8N_ENCRYPTION_KEY=your_n8n_encryption_secret_key
N8N_API_KEY=change_me_generate_with_openssl_rand_hex_32
N8N_CV_WEBHOOK=http://localhost:5678/webhook/process-cv
BACKEND_INTERNAL_URL=http://localhost:3001
