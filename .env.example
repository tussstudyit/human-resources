# Database Configuration
POSTGRES_USER=hr_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=hr_core_db
POSTGRES_PORT=5432

# Prisma Connection URL
DATABASE_URL="postgresql://hr_admin:your_secure_password@localhost:5432/hr_core_db?schema=public"

# n8n Automation Engine
N8N_PORT=5678
N8N_ENCRYPTION_KEY=your_n8n_encryption_secret_key
