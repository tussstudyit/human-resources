datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  HR
  EMPLOYEE
  MANAGER
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

model User {
  id              String                   @id @default(uuid())
  email           String                   @unique
  password        String
  fullName        String
  role            Role                     @default(EMPLOYEE)
  isActive        Boolean                  @default(true)

  departmentId    String?
  department      Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Day 4: Onboarding Tasks của User
  onboardingTasks EmployeeOnboardingTask[]

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@map("users")
}

enum JobStatus {
  OPEN
  CLOSED
}

enum AiStatus {
  PENDING
  DONE
  FAILED
}

enum CandidateStatus {
  APPLIED
  INTERVIEW
  HIRED
  REJECTED
}

model JobPost {
  id           String      @id @default(uuid())
  title        String
  description  String      @db.Text
  requirements String      @db.Text
  status       JobStatus   @default(OPEN)
  candidates   Candidate[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@map("job_posts")
}

model Candidate {
  id               String          @id @default(uuid())
  name             String
  email            String
  phone            String?
  cvUrl            String
  parsedSkillsJson Json?
  matchScore       Float?
  experienceYears  Int?
  summary          String?         @db.Text
  aiStatus         AiStatus        @default(PENDING)
  status           CandidateStatus @default(APPLIED)
  jobId            String
  job              JobPost         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([email, jobId])
  @@index([jobId])
  @@map("candidates")
}

// ==========================================
// DAY 4: ONBOARDING MODULE MODELS
// ==========================================

model OnboardingTemplate {
  id          String   @id @default(uuid())
  taskName    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("onboarding_templates")
}

model EmployeeOnboardingTask {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskName    String
  description String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("employee_onboarding_tasks")
}
