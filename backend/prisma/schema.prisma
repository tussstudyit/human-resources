datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  HR
  EMPLOYEE
  MANAGER
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  fullName String
  role     Role    @default(EMPLOYEE)
  isActive Boolean @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  onboardingTasks  OnboardingTask[]
  kpiMetrics       KpiMetric[]
  feedbackGiven    Feedback[]       @relation("FeedbackGiven")
  feedbackReceived Feedback[]       @relation("FeedbackReceived")
  certifications   Certification[]
  trainingROI      TrainingROI[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("users")
}

enum JobStatus {
  OPEN
  CLOSED
}

enum AiStatus {
  PENDING
  DONE
  FAILED
}

model JobPost {
  id             String             @id @default(uuid())
  title          String
  description    String             @db.Text
  requirements   String             @db.Text
  status         JobStatus          @default(OPEN)
  candidates     Candidate[]
  rubricVersions JobRubricVersion[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@map("job_posts")
}

model Candidate {
  id               String   @id @default(uuid())
  name             String
  email            String
  phone            String?
  cvUrl            String
  parsedSkillsJson Json?
  matchScore       Float?
  experienceYears  Int?
  summary          String?  @db.Text
  aiStatus         AiStatus @default(PENDING)
  jobId            String
  job              JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  latestEvaluationId String?
  evaluations        EvaluationRun[]

  @@unique([email, jobId])
  @@index([jobId])
  @@map("candidates")
}

model JobRubricVersion {
  id             String    @id @default(uuid())
  jobId          String
  job            JobPost   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceHash     String
  snapshot       Json
  requiredSkills Json
  weights        Json
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([jobId, sourceHash])
  @@map("job_rubric_versions")
}

model EvaluationRun {
  id            String            @id @default(uuid())
  candidateId   String
  candidate     Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status        String            @default("PENDING")
  rubricId      String?
  snapshot      Json
  report        Json?
  cvHash        String?
  modelId       String?
  promptVersion String            @default("hybrid-v1")
  errorCode     String?
  claimToken    String?
  claimedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime          @default(now())
  events        EvaluationEvent[]

  @@index([candidateId, createdAt])
  @@index([status, createdAt])
  @@map("evaluation_runs")
}

model EvaluationEvent {
  id               String        @id @default(uuid())
  evaluationId     String
  evaluation       EvaluationRun @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  type             String
  deduplicationKey String?       @unique
  data             Json
  createdAt        DateTime      @default(now())

  @@index([evaluationId, createdAt])
  @@map("evaluation_events")
}

model OnboardingTask {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  isCompleted Boolean   @default(false)
  dueDate     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("onboarding_tasks")
}

model KpiMetric {
  id          String @id @default(uuid())
  userId      String
  metricName  String
  targetValue Float
  actualValue Float
  period      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kpi_metrics")
}

model Feedback {
  id         String  @id @default(uuid())
  reviewerId String
  revieweeId String
  score      Int
  comment    String?
  period     String

  reviewer User @relation("FeedbackGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("FeedbackReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feedbacks")
}

model Certification {
  id             String    @id @default(uuid())
  name           String
  issuer         String?
  issueDate      DateTime
  expirationDate DateTime?
  credentialId   String?
  userId         String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expirationDate])
  @@map("certifications")
}

model TrainingROI {
  id           String    @id @default(uuid())
  trainingName String
  description  String?   @db.Text
  cost         Float
  benefit      Float
  trainingDate DateTime?
  userId       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("training_roi")
}
