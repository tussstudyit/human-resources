      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1100,
        200
      ],
      "name": "1. Webhook Trigger",
      "id": "wf07-webhook-trigger",
      "webhookId": "it-provisioning-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nreturn [{\n  json: {\n    userEmail: body.userEmail || body.email || 'newhire@company.vn',\n    fullName: body.fullName || body.name || 'Nhân sự mới',\n    department: body.department || 'Tech',\n    role: body.role || 'EMPLOYEE',\n    requestedAt: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        200
      ],
      "name": "2. Sanitize Data",
      "id": "wf07-sanitize-data"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-email-valid",
              "leftValue": "={{ $json.userEmail }}",
              "rightValue": "@",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -700,
        200
      ],
      "name": "3. Validate Email",
      "id": "wf07-validate-email"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"error\",\"message\":\"Invalid Email: userEmail must contain @\"}",
        "options": {
          "responseCode": 400
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -500,
        380
      ],
      "name": "4. Error Response",
      "id": "wf07-error-response"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst randNum = Math.floor(10000 + Math.random() * 90000);\nconst tempPwd = 'IT@' + Math.random().toString(36).slice(-6);\nreturn [{\n  json: {\n    ...item,\n    empId: 'EMP-' + randNum,\n    tempPwd: tempPwd,\n    slackHandle: '@' + (item.userEmail.split('@')[0] || 'user'),\n    githubAccount: item.userEmail.split('@')[0]\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        100
      ],
      "name": "5. Generate Credentials",
      "id": "wf07-gen-creds"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-dept-tech",
              "leftValue": "={{ $json.department }}",
              "rightValue": "Tech",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -300,
        100
      ],
      "name": "6. Check Department",
      "id": "wf07-check-dept"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    tools: ['Google Workspace', 'Slack Dev Channels', 'Jira Software', 'GitHub Organization', 'AWS Sandbox'],\n    tier: 'TECHNICAL_STACK'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ],
      "name": "7. Setup Tech Stack (Jira/Slack)",
      "id": "wf07-tech-stack"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    tools: ['Google Workspace', 'Slack General Channels', 'HR Portal', 'Notion Team Docs'],\n    tier: 'STANDARD_STACK'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        200
      ],
      "name": "8. Setup Standard Stack",
      "id": "wf07-standard-stack"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    mockApiStatus: '200_OK',\n    oktaProvisioned: true,\n    jiraAccessGranted: true,\n    slackAccountCreated: true,\n    provisionedAt: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        100
      ],
