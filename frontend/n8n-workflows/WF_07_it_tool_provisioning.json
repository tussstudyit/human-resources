        "jsCode": "const item = $('9. Mock IT Provisioning API').first().json;\nconst emailResult = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    emailStatus: emailResult.error ? 'EMAIL_FAILED' : 'EMAIL_SENT',\n    emailAccepted: emailResult.accepted || [],\n    auditStatus: 'PROVISIONED_AND_LOGGED',\n    auditTimestamp: new Date().toISOString()\n  }\n}];"
