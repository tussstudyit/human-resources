    },
    {
      "parameters": {
        "fromEmail": "tatcoolngau@gmail.com",
        "toEmail": "={{ $json.userEmail || 'anhtanht1905@gmail.com' }}",
        "subject": "=[IT Provisioning] Hoàn tất cấp phát tài khoản - {{$json.empId}}",
        "emailFormat": "html",
        "html": "=Xin chào {{$json.fullName || 'bạn'}},<br><br>Tài khoản công ty của bạn đã sẵn sàng!<br><b>Mã nhân viên:</b> {{$json.empId}}<br><b>Email:</b> {{$json.userEmail}}<br><b>Mật khẩu tạm thời:</b> {{$json.tempPwd}}<br><b>Công cụ cấp phát:</b> {{$json.tools ? $json.tools.join(', ') : 'IT Tools'}}.<br><br>Trân trọng,<br>IT Helpdesk",
        "options": {}
      },
