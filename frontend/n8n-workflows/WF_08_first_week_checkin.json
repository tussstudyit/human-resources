      "name": "2. Fetch Onboarding List",
      "id": "2008a122-472a-4bb9-97ad-1c6f21a51458"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const completed = Number(item.json.completed ?? 0);\n  const total = Number(item.json.total ?? 0);\n\n  const progress = total > 0\n    ? Math.round((completed / total) * 100)\n    : 0;\n\n  return {\n    json: {\n      ...item.json,\n      progress,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        112
      ],
      "name": "3. Calculate Progress %",
      "id": "5bcdf7fe-0659-422c-9ea9-b4baad8c479b"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.progressPercent }}",
              "operation": "smaller",
              "value2": 50
            }
          ],
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -208,
