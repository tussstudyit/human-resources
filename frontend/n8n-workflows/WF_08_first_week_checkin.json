    { "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 24 }] } }, "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-1100, 200], "name": "1. Cronjob Schedule" },
