    { "parameters": { "fromEmail": "tatcoolngau@gmail.com", "toEmail": "={{ $json.mentorEmail || 'anhtanht1905@gmail.com' }}", "subject": "=[Alert] Nhân sự chưa hoàn thành checklist tuần đầu", "html": "=Nhân sự cần hỗ trợ đẩy nhanh tiến độ checklist." }, "type": "n8n-nodes-base.emailSend", "typeVersion": 2.1, "position": [300, 100], "name": "9. Notify HR Mentor Email" },
