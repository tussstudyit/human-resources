      "webhookId": "hr-welcome-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst user = body.user || {};\n\nconst emailSubject = `🎉 Chào mừng ${user.fullName || 'bạn'} gia nhập đại gia đình công ty!`;\nconst emailHtml = `\n  <div style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 12px; overflow: hidden;\">\n    <div style=\"background: linear-gradient(135deg, #4f46e5, #7c3aed); padding: 24px; text-align: center; color: white;\">\n      <h1 style=\"margin: 0; font-size: 22px;\">Human Resources AI Platform</h1>\n      <p style=\"margin: 6px 0 0; font-size: 13px; opacity: 0.9;\">Hệ thống Quản trị & Hội nhập Tự động</p>\n    </div>\n    <div style=\"padding: 24px;\">\n      <h2 style=\"color: #1e1b4b; font-size: 18px;\">Xin chào <strong>${user.fullName || 'bạn'}</strong>,</h2>\n      <p>Chúc mừng bạn đã tạo tài khoản thành công trên nền tảng Nhân sự của chúng tôi!</p>\n      <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 13px;\">\n        <tr style=\"background: #f8fafc;\"><td style=\"padding: 10px; font-weight: bold;\">Email:</td><td style=\"padding: 10px;\">${user.email}</td></tr>\n        <tr><td style=\"padding: 10px; font-weight: bold;\">Vai trò:</td><td style=\"padding: 10px;\"><span style=\"background: #e0e7ff; color: #3730a3; padding: 3px 8px; border-radius: 4px; font-weight: bold;\">${user.role}</span></td></tr>\n        <tr style=\"background: #f8fafc;\"><td style=\"padding: 10px; font-weight: bold;\">Phòng ban:</td><td style=\"padding: 10px;\">${user.department || 'Chưa phân bổ'}</td></tr>\n      </table>\n      <p>🤖 <strong>AI Onboarding Agent</strong> sẽ tự động đồng hành cùng bạn để chuẩn bị checklist làm việc, cấp quyền công cụ và lộ trình đào tạo ngày đầu tiên.</p>\n      <p style=\"margin-top: 24px; color: #64748b; font-size: 12px;\">Trân trọng,<br><strong>Đội ngũ Nhân sự & 5 AI Agents</strong></p>\n    </div>\n  </div>\n`;\n\nreturn {\n  status: 'SUCCESS',\n  recipientEmail: user.email,\n  recipientName: user.fullName,\n  subject: emailSubject,\n  html: emailHtml,\n  processedAt: new Date().toISOString()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
