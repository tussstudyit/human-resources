    {
      "name": "Validate Calendar Result",
      "id": "14473b8f660ee05d05e9ee59",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        1100
      ],
      "parameters": {
        "jsCode": "const plan=$('Plan Interview').first().json;const url=$json.hangoutLink||$json.conferenceData?.entryPoints?.find(p=>p.entryPointType==='video')?.uri;\nreturn [{json:{...plan,eventId:$json.id||null,meetUrl:url||null,calendarValid:!!$json.id&&typeof url==='string'&&url.startsWith('https://meet.google.com/')&&/^[a-z0-9-]+$/i.test(url.slice(24))}}];"
      }
    },
