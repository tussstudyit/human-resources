    {
      "name": "Plan Interview",
      "id": "e9bcb601d089150e79613547",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        440
      ],
      "parameters": {
        "jsCode": "const ctx=$('Claim Approved Delivery').first().json;const type=ctx.options.interviewType||'ONLINE';if(!['ONLINE','OFFLINE'].includes(type))throw Error('INVALID_INTERVIEW_TYPE');\nconst local=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Ho_Chi_Minh',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());\nconst date=new Date(local+'T02:30:00.000Z');let days=3;while(days){date.setUTCDate(date.getUTCDate()+1);if(![0,6].includes(date.getUTCDay()))days--;}\nreturn [{json:{ctx,type,start:date.toISOString(),end:new Date(date.getTime()+3600000).toISOString(),online:type==='ONLINE'}}];"
      },
      "onError": "continueErrorOutput"
    },
