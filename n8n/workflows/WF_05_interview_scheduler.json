    {
      "name": "Create Google Calendar and Meet",
      "id": "b1a76ef6aa5cf29047dd5caf",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        400,
        880
      ],
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
