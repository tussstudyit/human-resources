    {
      "name": "Build Invitation and ICS",
      "id": "4fdeba3976bdd85b1e37d642",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        220
      ],
      "parameters": {
        "jsCode": "const esc=s=>String(s||'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const plan=$('Plan Interview').first().json;const ctx=plan.ctx;const result=plan.online?$json:{};const location=plan.online?result.meetUrl:'HR sẽ xác nhận địa điểm phỏng vấn trực tiếp.';\nconst fmt=s=>s.replace(/[-:]/g,'').split('.')[0]+'Z';const slash=String.fromCharCode(92);const clean=s=>String(s).split(slash).join(slash+slash).split(String.fromCharCode(13)).join(' ').split(String.fromCharCode(10)).join(' ').split(',').join(slash+',').split(';').join(slash+';');\nconst ics=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//HR Tech//Interview//VI','METHOD:REQUEST','BEGIN:VEVENT','UID:'+ctx.evaluationId+'@hrtech', 'DTSTAMP:'+fmt(new Date().toISOString()),'DTSTART:'+fmt(plan.start),'DTEND:'+fmt(plan.end),'SUMMARY:'+clean('Phỏng vấn '+ctx.jobTitle),'LOCATION:'+clean(location),'STATUS:CONFIRMED','SEQUENCE:0','END:VEVENT','END:VCALENDAR'].join(String.fromCharCode(13,10));\nconst binary=await this.helpers.prepareBinaryData(Buffer.from(ics),'interview.ics','text/calendar');\nreturn [{json:{ctx,subject:'Thư mời phỏng vấn – '+ctx.jobTitle,html:'<p>Chào '+esc(ctx.candidateName)+',</p><p>Thời gian: '+esc(new Date(plan.start).toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'}))+'</p><p>'+esc(location)+'</p><p><a href=\"'+esc(ctx.rsvpUrl)+'\">Xác nhận hoặc đề nghị dời lịch</a></p>',metadata:{time:plan.start,type:plan.type,googleMeetUrl:result.meetUrl||null,isRealGoogleMeet:!!result.meetUrl,googleCalendarEventId:result.eventId||null}},binary:{calendar:binary}}];"
      },
      "onError": "continueErrorOutput"
    },
