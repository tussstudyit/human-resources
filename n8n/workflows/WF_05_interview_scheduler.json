        "start": "={{ $('Plan Interview').first().json.start }}",
        "end": "={{ $('Plan Interview').first().json.end }}",
        "additionalFields": {
          "summary": "={{ 'Phỏng vấn ' + $('Plan Interview').first().json.ctx.jobTitle }}",
          "description": "Phỏng vấn đã được HR duyệt.",
          "attendees": [
            "={{ $('Plan Interview').first().json.ctx.candidateEmail }}"
          ],
          "conferenceDataUi": {
            "conferenceDataValues": {
              "conferenceSolution": "hangoutsMeet"
            }
