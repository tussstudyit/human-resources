      ],
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:3001/recruitment/evaluations/{{ $json.ctx.evaluationId }}/delivery",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Receive Approved Action').first().json.headers['x-api-key'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {action:\"INTERVIEW\",status:$json.status,metadata:$json.metadata} }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
