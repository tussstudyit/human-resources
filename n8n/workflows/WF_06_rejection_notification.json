      ],
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:3001/recruitment/evaluations/{{ $json.ctx.evaluationId }}/delivery",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Receive Approved Action').first().json.headers['x-api-key'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {action:\"TALENT_POOL\",status:$json.status,metadata:$json.metadata} }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "name": "Reject Unauthorized or Unavailable",
      "id": "5b52ed716c21e62ba45abc3d",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        800,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {error:\"DELIVERY_CLAIM_REJECTED_OR_UNAVAILABLE\"} }}",
        "options": {
          "responseCode": 503
        }
      }
    }
  ],
