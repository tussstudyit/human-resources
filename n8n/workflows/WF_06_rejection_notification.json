      "name": "Prepare Delivery Failure",
      "id": "9019b82194ad5afad289f551",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        1100
      ],
      "parameters": {
        "jsCode": "const ctx=$('Claim Approved Delivery').first().json;return [{json:{ctx,status:'FAILED',metadata:{errorCode:'PROVIDER_OR_PROCESSING_FAILED'}}}];"
      }
    },
    {
      "name": "Record Actual Delivery",
      "id": "e3ac34c133c0a082bf55dcfa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
