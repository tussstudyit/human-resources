    {
      "name": "Build Talent Pool Feedback",
      "id": "89905f83ad1bed842e0f0ae5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        440
      ],
      "parameters": {
        "jsCode": "const esc=s=>String(s||'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const ctx=$('Claim Approved Delivery').first().json;const allowed=['CV_SCREENING','POST_INTERVIEW','TECHNICAL_TEST','CULTURE_FIT','TOP_TALENT'];const scenario=allowed.includes(ctx.options.stage)?ctx.options.stage:'CV_SCREENING';const reEngagementDate=new Date(Date.now()+180*86400000).toISOString().slice(0,10);\nreturn [{json:{ctx,subject:'Phản hồi hồ sơ ứng tuyển – '+ctx.jobTitle,html:'<p>Chào '+esc(ctx.candidateName)+',</p><p>Cảm ơn bạn đã ứng tuyển '+esc(ctx.jobTitle)+'. Sau khi xem xét, bộ phận tuyển dụng hiện chưa tiếp tục hồ sơ cho vị trí này. Chúng tôi trân trọng thời gian và sự quan tâm của bạn.</p><p>Nếu bạn đồng ý lưu hồ sơ, HR có thể liên hệ khi có cơ hội phù hợp.</p><p><a href=\"'+esc(ctx.cxUrl)+'\">Đánh giá trải nghiệm tuyển dụng</a></p>',metadata:{tier:'RETAINED_TALENT_POOL',scenario,reEngagementDate}}}];"
      }
    },
    {
      "name": "Send Candidate Email",
      "id": "71d37e872d64868ed397e077",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        400,
        660
      ],
      "parameters": {
        "fromEmail": "doanthanhhuy1309@gmail.com",
        "toEmail": "={{ $json.ctx.candidateEmail }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "GmailSmtpCred01",
          "name": "Gmail SMTP"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "name": "Inspect SMTP Outcome",
      "id": "ffcc8cc61c66111bdbfbb07d",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        880
      ],
      "parameters": {
        "jsCode": "const packet=$('Build Talent Pool Feedback').first().json;const accepted=$json.accepted;const ok=!$json.error&&Array.isArray(accepted)&&accepted.some(e=>String(e).toLowerCase()===packet.ctx.candidateEmail.toLowerCase());return [{json:{ctx:packet.ctx,status:ok?'SENT':'FAILED',metadata:packet.metadata}}];"
      }
    },
    {
      "name": "Prepare Delivery Failure",
      "id": "9019b82194ad5afad289f551",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        1100
      ],
      "parameters": {
        "jsCode": "const ctx=$('Claim Approved Delivery').first().json;return [{json:{ctx,status:'FAILED',metadata:{errorCode:'PROVIDER_OR_PROCESSING_FAILED'}}}];"
      }
    },
    {
      "name": "Record Actual Delivery",
      "id": "e3ac34c133c0a082bf55dcfa",
