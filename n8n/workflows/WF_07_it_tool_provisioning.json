    {
      "parameters": {
        "mode": "manual",
        "duplicateItems": false,
        "assignments": {
          "assignments": [
            {
              "id": "sanitize-email",
              "name": "userEmail",
              "value": "={{ $json.body?.userEmail || $json.body?.personalEmail || $json.body?.email || $json.userEmail || $json.personalEmail || $json.email }}",
              "type": "string"
            },
            {
              "id": "sanitize-name",
              "name": "fullName",
              "value": "={{ $json.body?.fullName || $json.body?.name || $json.fullName || 'Nhân sự mới' }}",
              "type": "string"
            },
            {
              "id": "sanitize-dept",
              "name": "department",
              "value": "={{ $json.body?.department || $json.department || 'Tech' }}",
              "type": "string"
            },
            {
              "id": "sanitize-role",
              "name": "role",
              "value": "={{ $json.body?.role || $json.role || 'EMPLOYEE' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -900,
        200
