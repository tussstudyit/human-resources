    {
      "parameters": {
        "method": "POST",
        "url": "https://httpbin.org/post",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  channel: '@hr_management_alerts',\n  text: 'Đã gửi nhắc nhở 360 Feedback cho ' + $json.fullName + ' (' + $json.email + ') kỳ ' + $json.period,\n  status: 'DISPATCHED'\n}) }}",
        "options": {
          "timeout": 5000
