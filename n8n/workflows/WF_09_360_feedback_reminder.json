{
  "id": "WF09feedbackremind",
  "name": "WF_09_360_feedback_reminder",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {
    "1. Monthly Cronjob (25th)": [
      {
        "json": {
          "timestamp": "2026-10-25T09:00:00.000Z",
          "userId": "usr-emp-042",
          "email": "dang.2006.qt@gmail.com",
          "fullName": "Đặng Tú Nguyên",
          "period": "2026-Q4",
          "hasSubmitted": false,
          "deadline": "28 hàng tháng"
        }
      }
    ]
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 25 * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1100,
        200
      ],
      "name": "1. Monthly Cronjob (25th)",
      "id": "wf09-cron-trigger"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItems": false,
        "assignments": {
          "assignments": [
            {
              "id": "wf09-set-uid",
              "name": "userId",
              "value": "={{ $json.userId || 'usr-emp-042' }}",
              "type": "string"
            },
            {
              "id": "wf09-set-email",
              "name": "email",
              "value": "={{ $json.email || 'dang.2006.qt@gmail.com' }}",
              "type": "string"
            },
            {
              "id": "wf09-set-name",
              "name": "fullName",
              "value": "={{ $json.fullName || 'Đặng Tú Nguyên' }}",
              "type": "string"
            },
            {
              "id": "wf09-set-period",
              "name": "period",
              "value": "={{ $json.period || '2026-Q4' }}",
              "type": "string"
            },
            {
              "id": "wf09-set-submitted",
              "name": "hasSubmitted",
              "value": "={{ $json.hasSubmitted !== undefined ? $json.hasSubmitted : false }}",
              "type": "boolean"
            },
            {
              "id": "wf09-set-deadline",
              "name": "deadline",
              "value": "={{ $json.deadline || '28 hàng tháng' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -900,
        200
      ],
      "name": "2. Query Pending Reviews",
      "id": "wf09-query-pending"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const json = item.json;\n  const uid = json.userId || 'usr-emp-042';\n  const period = json.period || '2026-Q4';\n  const token = Buffer.from(`${uid}:${period}:${Date.now()}`).toString('base64url');\n  return {\n    json: {\n      ...json,\n      token: token,\n      magicLink: `http://localhost:3000/performance?token=${token}&period=${period}`\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        200
      ],
      "name": "3. Generate Magic Links",
      "id": "wf09-gen-links"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-not-submitted",
              "leftValue": "={{ $json.hasSubmitted }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -500,
        200
      ],
      "name": "4. Check Submission Status",
      "id": "wf09-check-status"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItems": false,
        "assignments": {
          "assignments": [
            {
              "id": "wf09-rem-state",
              "name": "reminderState",
              "value": "PENDING_SUBMISSION",
              "type": "string"
            },
            {
              "id": "wf09-rem-prio",
              "name": "priority",
              "value": "HIGH",
              "type": "string"
            },
            {
              "id": "wf09-rem-note",
              "name": "filterNote",
              "value": "User has not submitted review for current period",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -300,
        100
      ],
      "name": "5. Filter Unsubmitted Users",
      "id": "wf09-filter-unsubmitted"
    },
