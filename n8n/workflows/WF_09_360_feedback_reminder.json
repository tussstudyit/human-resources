      "parameters": {
        "mode": "manual",
        "duplicateItems": false,
        "assignments": {
          "assignments": [
            {
              "id": "wf09-skip-state",
              "name": "reminderState",
              "value": "ALREADY_COMPLETED",
              "type": "string"
            },
            {
              "id": "wf09-skip-note",
              "name": "note",
              "value": "User has already submitted 360 review for this period.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -300,
        300
      ],
      "name": "6. Skip Completed Users",
      "id": "wf09-skip-completed"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItems": false,
        "assignments": {
          "assignments": [
            {
              "id": "wf09-tpl-subj",
              "name": "subject",
              "value": "={{ '[360 Feedback] Nhắc nhở nộp đánh giá hiệu suất kỳ ' + $json.period }}",
              "type": "string"
            },
            {
              "id": "wf09-tpl-html",
              "name": "html",
              "value": "={{ 'Xin chào <b>' + $json.fullName + '</b>,<br><br>Hạn chót đánh giá hiệu suất 360 độ kỳ ' + $json.period + ' đang đến gần (' + $json.deadline + ').<br>Vui lòng truy cập đường dẫn trực tiếp dưới đây để hoàn tất biểu mẫu đánh giá:<br><br><a href=\"' + $json.magicLink + '\" style=\"display:inline-block;padding:10px 20px;background-color:#4f46e5;color:white;text-decoration:none;border-radius:6px;font-weight:bold;\">Mở biểu mẫu đánh giá 360°</a><br><br>Nếu nút trên không hoạt động, bạn có thể copy link: ' + $json.magicLink + '<br><br>Trân trọng,<br>Phòng Quản trị Nhân sự & Hiệu suất' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -100,
        100
      ],
      "name": "7. Build Email Template",
      "id": "wf09-build-template"
    },
    {
      "parameters": {
        "fromEmail": "tatcoolngau@gmail.com",
        "toEmail": "={{ $json.email || 'dang.2006.qt@gmail.com' }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        100,
        100
      ],
