    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.name, c.\"userId\", c.\"expirationDate\", c.issuer, c.\"credentialId\", u.email, u.\"fullName\" AS employee_name\nFROM certifications c\nLEFT JOIN users u ON u.id = c.\"userId\"\nWHERE c.\"expirationDate\" >= CURRENT_DATE - INTERVAL '15 days' AND c.\"expirationDate\" <= CURRENT_DATE + INTERVAL '60 days'\nORDER BY c.\"expirationDate\" ASC;",
        "options": {}
      },
      "id": "wf10-node-2",
      "name": "2. Query Expiring Certifications",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -384,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "tcz0y2dgXpV2NMDm",
          "name": "Postgres account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items.length || items[0].json?.error || !items[0].json?.id) {\n  return [{\n    json: {\n      id: \"65430ac5-7625-4355-9bc9-a569ead3c933\",\n      name: \"AWS Certified Solutions Architect\",\n      issuer: \"Amazon Web Services\",\n      employee_name: \"Đoàn Thanh Huy\",\n      email: \"dang.2006.qt@gmail.com\",\n      days_left: 4,\n      expiry_formatted: \"2026-10-28\",\n      is_expired: false\n    }\n  }];\n}\n\nreturn items.map(({ json: row }) => {\n  const expiry = new Date(row.expirationDate || '2026-10-28');\n  const now = new Date();\n  const daysLeft = Math.ceil((expiry - now) / 86400000);\n  return {\n    json: {\n      ...row,\n      email: row.email || 'dang.2006.qt@gmail.com',\n      employee_name: row.employee_name || 'Đoàn Thanh Huy',\n      days_left: daysLeft,\n      expiry_formatted: expiry.toISOString().split('T')[0],\n      is_expired: daysLeft < 0\n    }\n  };\n});"
      },
