    {
      "parameters": {
        "jsCode": "const data = $json;\nconst emailSubject = `[${data.urgencyLevel === 'CRITICAL_URGENT' ? '🚨 KHẨN CẤP' : '⚠️ NHẮC NHỞ'}] Chứng chỉ ${data.name} sắp hết hạn (còn ${data.days_left} ngày)`;\n\nconst emailHtml = `<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"></head>\n<body style=\"font-family: Arial, sans-serif; background-color: #f8fafc; padding: 24px; color: #1e293b;\">\n  <div style=\"max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);\">\n    <div style=\"background: ${data.colorHex}; padding: 16px 24px; color: #ffffff; font-weight: bold; font-size: 16px;\">\n      ${data.alertBadge}\n    </div>\n    <div style=\"padding: 24px;\">\n      <p style=\"font-size: 15px;\">Xin chào <strong>${data.employee_name}</strong>,</p>\n      <p style=\"font-size: 14px; line-height: 1.6; color: #334155;\">\n        Hệ thống Quản lý Kỹ năng & Đào tạo nhận thấy chứng chỉ chuyên môn của bạn sắp hết hạn hiệu lực:\n      </p>\n      <div style=\"background: #f1f5f9; border-left: 4px solid ${data.colorHex}; padding: 14px 18px; border-radius: 6px; margin: 18px 0; font-size: 14px;\">\n        <p style=\"margin: 4px 0;\"><strong>Chứng chỉ:</strong> ${data.name}</p>\n        <p style=\"margin: 4px 0;\"><strong>Đơn vị cấp:</strong> ${data.issuer || 'Tổ chức chuyên môn'}</p>\n        <p style=\"margin: 4px 0;\"><strong>Ngày hết hạn:</strong> ${data.expiry_formatted} (<strong>còn ${data.days_left} ngày</strong>)</p>\n        <p style=\"margin: 4px 0; color: ${data.colorHex}; font-weight: bold;\"><strong>Hành động:</strong> ${data.actionRequired}</p>\n      </div>\n      <p style=\"font-size: 13px; color: #64748b;\">\n        Mọi chi phí tái cấp chứng chỉ được công ty tài trợ 100% theo chính sách Phát triển Nhân tài năm 2026.\n      </p>\n      <hr style=\"border: 0; border-top: 1px solid #e2e8f0; margin: 20px 0;\">\n      <p style=\"font-size: 13px; color: #94a3b8; margin: 0;\">Trân trọng,<br><strong>Phòng Quản lý Kỹ năng & Đào tạo HR Tech</strong></p>\n    </div>\n  </div>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    ...data,\n    email_subject: emailSubject,\n    email_html: emailHtml,\n    slack_payload: {\n      channel: \"#hr-certifications-alert\",\n      text: `*${data.alertBadge}*\nNhân sự: *${data.employee_name}*\nChứng chỉ: *${data.name}*\nThời hạn còn: *${data.days_left} ngày* (Hết hạn: ${data.expiry_formatted})\n${data.actionRequired}`\n    },\n    audit_log: {\n      certId: data.id,\n      certName: data.name,\n      employee: data.employee_name,\n      urgency: data.urgencyLevel,\n      loggedAt: new Date().toISOString()\n    }\n  }\n}];"
      },
