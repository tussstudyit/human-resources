{
  "id": "WF10certexp00001",
  "name": "WF_10_cert_expiration_alert",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "daily-at-00:00",
      "name": "Daily at 00:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.name, c.\"userId\", c.\"expirationDate\", u.email, u.\"fullName\" AS employee_name\nFROM certifications c\nLEFT JOIN users u ON u.id = c.\"userId\"\nWHERE c.\"expirationDate\" >= CURRENT_DATE AND c.\"expirationDate\" < CURRENT_DATE + INTERVAL '31 days'\nORDER BY c.\"expirationDate\" ASC;",
        "options": {}
      },
      "id": "get-expiring-certificates",
      "name": "Get expiring certificates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "PostgresHrDbCred",
          "name": "Postgres HR DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({json: row}) => {\n  const expiry = new Date(row.expirationDate);\n  const now = new Date();\n  const daysLeft = Math.max(0, Math.ceil((expiry - now) / 86400000));\n  const expStr = expiry.toISOString().split('T')[0];\n  return {\n    json: {\n      ...row,\n      days_left: daysLeft,\n      expiry_formatted: expStr,\n      alert_subject: `[Chứng chỉ sắp hết hạn] ${row.name} - ${row.employee_name || 'Nhân sự'} (còn ${daysLeft} ngày)`,\n      alert_message: `Chứng chỉ \"${row.name}\" của nhân sự ${row.employee_name || row.userId} sẽ hết hạn trong ${daysLeft} ngày tới (ngày ${expStr}). Vui lòng lên kế hoạch tái cấp hoặc đăng ký thi gia hạn.`\n    }\n  };\n});"
      },
      "id": "prepare-alert-rows",
      "name": "Prepare alert rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-rows",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-expiring-certificates",
      "name": "Has expiring certificates?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "tatcoolngau@gmail.com",
        "toEmail": "={{ $json.email || 'hr.training@company.vn' }}",
        "subject": "={{ $json.alert_subject }}",
        "emailFormat": "html",
        "html": "=Xin chào <b>{{ $json.employee_name }}</b> và Bộ phận Đào tạo,<br><br>{{ $json.alert_message }}<br><br><b>Thông tin chi tiết:</b><br>- Chứng chỉ: {{ $json.name }}<br>- Ngày hết hạn: {{ $json.expiry_formatted }} (còn {{ $json.days_left }} ngày)<br><br>Trân trọng,<br>Hệ thống Quản lý Kỹ năng & Đào tạo HR",
        "options": {}
      },
      "id": "send-alert-to-hr",
      "name": "Send alert to HR (configure)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1120,
        220
      ],
      "credentials": {
        "smtp": {
          "id": "GmailSmtpCred01",
          "name": "Gmail SMTP"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {},
      "id": "no-certificates-to-alert",
      "name": "No certificates to alert",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1120,
        420
      ]
    }
  ],
  "connections": {
    "Daily at 00:00": {
      "main": [
        [
          {
            "node": "Get expiring certificates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get expiring certificates": {
      "main": [
        [
          {
            "node": "Prepare alert rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare alert rows": {
      "main": [
        [
          {
            "node": "Has expiring certificates?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has expiring certificates?": {
      "main": [
        [
          {
            "node": "Send alert to HR (configure)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No certificates to alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}