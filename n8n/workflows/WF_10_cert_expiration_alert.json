    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body || $input.first().json;\nconst employee_name = raw.employeeName || 'Nhân sự';\nconst email = raw.employeeEmail || 'dang.2006.qt@gmail.com';\nconst name = raw.courseName || 'Khóa đào tạo chuyên môn';\nconst dueDateStr = raw.dueDate || '30/10/2026';\n\nlet expiry = new Date();\nif (dueDateStr.includes('/')) {\n  const parts = dueDateStr.split('/');\n  if (parts.length === 3) {\n    expiry = new Date(`${parts[2]}-${parts[1]}-${parts[0]}`);\n  }\n} else {\n  expiry = new Date(dueDateStr);\n}\nif (isNaN(expiry.getTime())) {\n  expiry = new Date(Date.now() + 5 * 86400000);\n}\n\nconst now = new Date();\nconst daysLeft = Math.ceil((expiry - now) / 86400000);\n\nreturn [{\n  json: {\n    id: 'reminder-' + Date.now(),\n    name: name,\n    issuer: 'Hệ Thống Đào Tạo Doanh Nghiệp (L&D UpCareer)',\n    employee_name: employee_name,\n    email: email,\n    days_left: daysLeft,\n    expiry_formatted: expiry.toISOString().split('T')[0],\n    is_expired: daysLeft < 0\n  }\n}];"
      },
