    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst emailSubject = `[AI L&D Portal] Lộ trình đào tạo đề xuất: ${data.skill_name} - ${data.employee_name}`;\n\nconst emailHtml = `<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"></head>\n<body style=\"font-family: Arial, sans-serif; background-color: #f8fafc; padding: 24px; color: #1e293b;\">\n  <div style=\"max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);\">\n    <div style=\"background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); padding: 20px 24px; color: #ffffff;\">\n      <h2 style=\"margin: 0; font-size: 18px;\">LỘ TRÌNH ĐÀO TẠO & PHÁT TRIỂN NĂNG LỰC CÁ NHÂN</h2>\n      <p style=\"margin: 6px 0 0 0; font-size: 13px; opacity: 0.9;\">AI Skill Gap Engine • Enterprise Learning Path</p>\n    </div>\n    <div style=\"padding: 24px;\">\n      <p style=\"font-size: 15px;\">Kính gửi <strong>${data.employee_name}</strong>,</p>\n      <p style=\"font-size: 14px; line-height: 1.6; color: #334155;\">\n        Dựa trên kết quả rà soát khung năng lực chuẩn của phòng ban, Hệ thống Đào tạo & AI L&D trân trọng đề xuất khóa học nâng cấp kỹ năng cho bạn:\n      </p>\n      <div style=\"background: #eff6ff; border-left: 4px solid #2563eb; padding: 16px; border-radius: 8px; margin: 18px 0; font-size: 14px;\">\n        <p style=\"margin: 4px 0;\"><strong>Kỹ năng mục tiêu:</strong> ${data.skill_name}</p>\n        <p style=\"margin: 4px 0;\"><strong>Khoảng cách năng lực (Gap):</strong> Level ${data.current_level} ➔ <strong>Level ${data.required_level}</strong> (Độ ưu tiên: ${data.severity})</p>\n        <p style=\"margin: 4px 0;\"><strong>Khóa học đề xuất:</strong> ${data.recommendedCourse}</p>\n        <p style=\"margin: 4px 0;\"><strong>Nền tảng đào tạo:</strong> ${Array.isArray(data.providers) ? data.providers.join(', ') : data.providers}</p>\n        <p style=\"margin: 4px 0;\"><strong>Thời lượng ước tính:</strong> ${data.estimatedHours} giờ học tập</p>\n      </div>\n      <div style=\"text-align: center; margin: 24px 0;\">\n        <a href=\"${data.learningUrl}\" style=\"background-color: #2563eb; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: bold; font-size: 14px; display: inline-block;\">Kích hoạt tài khoản học tập</a>\n      </div>\n      <p style=\"font-size: 13px; color: #64748b;\">\n        * Toàn bộ chi phí cấp bản quyền tài khoản khóa học được HR Tech Hub tài trợ 100%.\n      </p>\n      <hr style=\"border: 0; border-top: 1px solid #e2e8f0; margin: 20px 0;\">\n      <p style=\"font-size: 13px; color: #94a3b8; margin: 0;\">Trân trọng,<br><strong>Ban Giám Đốc Nhân Sự & Bộ Phận Đào Tạo (AI L&D Team)</strong></p>\n    </div>\n  </div>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    ...data,\n    email_subject: emailSubject,\n    email_html: emailHtml\n  }\n}];"
      },
