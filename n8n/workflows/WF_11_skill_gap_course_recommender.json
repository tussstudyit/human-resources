    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id AS user_id, u.\"fullName\" AS employee_name, u.email, s.skill_name, s.current_level, s.required_level\nFROM users u\nJOIN employee_skills s ON s.user_id = u.id\nWHERE COALESCE(s.current_level, 0) < COALESCE(s.required_level, 0)\nORDER BY (s.required_level - s.current_level) DESC, s.skill_name ASC;",
        "options": {}
      },
      "id": "wf11-node-3",
      "name": "3. Query Skill Gaps from Database",
      "type": "n8n-nodes-base.postgres",
