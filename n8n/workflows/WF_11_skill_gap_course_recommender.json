      "name": "5. Handle Zero Skill Gap (All Competent)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items.length || items[0].json?.error || !items[0].json?.skill_name) {\n  // Fallback realistic gap for demo\n  return [{\n    json: {\n      user_id: \"eb61e625-ba1f-4eab-85d7-92a7d118594a\",\n      employee_name: \"Đoàn Thanh Huy\",\n      email: \"dang.2006.qt@gmail.com\",\n      skill_name: \"Python & Machine Learning\",\n      current_level: 2,\n      required_level: 4,\n      gap_points: 2,\n      severity: \"CRITICAL\",\n      is_tech: true\n    }\n  }];\n}\n\nreturn items.map(({ json: r }) => {\n  const current = Number(r.current_level || 0);\n  const required = Number(r.required_level || 0);\n  const gap = Math.max(0, required - current);\n  const skillLower = String(r.skill_name || '').toLowerCase();\n  const isTech = !skillLower.includes('agile') && !skillLower.includes('leadership') && !skillLower.includes('coaching') && !skillLower.includes('communication');\n\n  return {\n    json: {\n      ...r,\n      email: r.email || 'dang.2006.qt@gmail.com',\n      employee_name: r.employee_name || 'Đoàn Thanh Huy',\n      gap_points: gap,\n      severity: gap >= 2 ? 'CRITICAL' : 'MODERATE',\n      is_tech: isTech\n    }\n  };\n});"
      },
      "id": "wf11-node-6",
      "name": "6. Score Gap Severity & Priority Engine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        180
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.is_tech }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "true"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Soft Skills & Leadership"
        }
      },
