{
  "id": "WF12sysuptime001",
  "name": "WF_12_system_uptime_monitor",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "every-15-minutes",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.MONITOR_WEB_URL || 'http://host.docker.internal:3000' }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "check-web",
      "name": "Check Web",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        180
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "={{ $env.MONITOR_API_URL || 'http://host.docker.internal:3001' }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "check-api",
      "name": "Check API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        320
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "={{ $env.MONITOR_DB_HEALTH_URL || 'http://host.docker.internal:3001/departments' }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "check-database-health-endpoint",
      "name": "Check database health endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        460
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const webItem = $('Check Web').first();\nconst apiItem = $('Check API').first();\nconst dbItem = $('Check database health endpoint').first();\n\nconst webOk = !webItem?.error && webItem?.json !== undefined;\nconst apiOk = !apiItem?.error && apiItem?.json !== undefined;\nconst dbOk = !dbItem?.error && dbItem?.json !== undefined;\n\nconst checks = [\n  { service: 'Web Frontend (Next.js)', ok: webOk, status: webOk ? 200 : 503 },\n  { service: 'API Backend (NestJS)', ok: apiOk, status: apiOk ? 200 : 503 },\n  { service: 'Database (PostgreSQL via API)', ok: dbOk, status: dbOk ? 200 : 503 }\n];\n\nreturn checks.map(c => ({\n  json: {\n    service: c.service,\n    status: c.status,\n    ok: c.ok,\n    checked_at: new Date().toISOString(),\n    message: c.ok \n      ? `✅ ${c.service} is UP and healthy (status ${c.status}).` \n      : `🚨 ALERT: ${c.service} is DOWN or not responding (status ${c.status})!`\n  }\n}));"
      },
      "id": "combine-check-results",
      "name": "Combine check results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-failure",
              "leftValue": "={{ $json.ok }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "failure",
      "name": "Failure?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL || 'https://httpbin.org/post' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: $json.message, service: $json.service, checked_at: $json.checked_at } }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-alert-to-chat",
      "name": "Send alert to chat (configure)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        220
      ],
      "continueOnFail": true
    },
    {
      "parameters": {},
      "id": "healthy-service",
      "name": "Healthy service",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1140,
        420
      ]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Check Web",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check API",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check database health endpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Web": {
      "main": [
        [
          {
            "node": "Combine check results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check API": {
      "main": [
        [
          {
            "node": "Combine check results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check database health endpoint": {
      "main": [
        [
          {
            "node": "Combine check results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Combine check results": {
      "main": [
        [
          {
            "node": "Failure?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Failure?": {
      "main": [
        [
          {
            "node": "Send alert to chat (configure)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Healthy service",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}