        "jsCode": "const data = $input.first()?.json || $json;\nreturn [{\n  json: {\n    success: true,\n    workflow: \"WF_12_SYSTEM_UPTIME_MONITOR\",\n    auditState: \"MONITORING_CYCLE_COMPLETED\",\n    healthSummary: data,\n    completedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "wf12-node-12",
      "name": "12. Finalize Health Metric Audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        260
      ]
    }
