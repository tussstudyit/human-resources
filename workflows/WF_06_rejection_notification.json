      "id": "ffcc8cc61c66111bdbfbb07d",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        880
      ],
      "parameters": {
        "jsCode": "const packet=$('Build Talent Pool Feedback').first().json;const accepted=$json.accepted;const ok=!$json.error&&Array.isArray(accepted)&&accepted.some(e=>String(e).toLowerCase()===packet.ctx.candidateEmail.toLowerCase());return [{json:{ctx:packet.ctx,status:ok?'SENT':'FAILED',metadata:packet.metadata}}];"
      }
    },
    {
      "name": "Prepare Delivery Failure",
      "id": "9019b82194ad5afad289f551",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        1100
      ],
      "parameters": {
        "jsCode": "const ctx=$('Claim Approved Delivery').first().json;return [{json:{ctx,status:'FAILED',metadata:{errorCode:'PROVIDER_OR_PROCESSING_FAILED'}}}];"
      }
    },
    {
      "name": "Record Actual Delivery",
      "id": "e3ac34c133c0a082bf55dcfa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:3001/recruitment/evaluations/{{ $json.ctx.evaluationId }}/delivery",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Receive Approved Action').first().json.headers['x-api-key'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {action:\"TALENT_POOL\",status:$json.status,metadata:$json.metadata} }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
